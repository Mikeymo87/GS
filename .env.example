# Copy to .env and fill in. The app also lets you paste a key in-app (Settings ⚙️),
# which is stored only on your device and overrides the server key per request.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=3000
MODEL=claude-sonnet-4-6
# WEB_SEARCH_TOOL=web_search_20250305
# MAX_SEARCHES=6
# THINK_BUDGET=2500
